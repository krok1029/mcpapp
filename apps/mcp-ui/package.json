{
  "name": "@mcpapp/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The host-neutral McpApp Project Console UI resource.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "19",
    "react-dom": "19"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jsdom": "^30",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "6",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "vite": "8"
  }
}
